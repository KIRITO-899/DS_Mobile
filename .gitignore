# =============================================================================
# Data & Datasets
# Note: Anchored to root so that app code packages (e.g. com/.../data) are tracked
# =============================================================================
/data/
/datasets/
*.csv
*.tsv
*.parquet
*.feather
*.pkl
*.pickle
*.npy
*.npz

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar

# =============================================================================
# Android & Gradle — Build Artifacts & Zero Personal Data Leak Protection
# =============================================================================
# Local machine configurations & user paths (Prevents leaking local usernames/SDK paths)
local.properties
*.local.properties
gradle.local.properties

# Gradle internal cache & daemon execution data
.gradle/
**/.gradle/
**/build/
reports/

# Kotlin compiler daemon sessions & memory
.kotlin/
**/.kotlin/

# Android binaries, packages & compilation outputs
*.apk
*.ap_
*.aab
*.dex
*.class
output.json

# Signing keys, certificates & release keystores (Critical security protection)
*.jks
*.keystore
debug.keystore
signing-report.txt
signing.properties

# Cloud, Firebase & Google Services client credentials
google-services.json
google-services.xml
secrets.xml
secrets.properties

# Android memory dumps & runtime profiling (Prevents leaking user device RAM / sensitive inputs)
captures/
*.hprof

# Native C++ / NDK build intermediates and compile commands
.externalNativeBuild/
**/.externalNativeBuild/
.cxx/
**/.cxx/

# Explicit Whitelists for Android
# Gradle wrapper jar must be tracked for reproducible builds
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Allow Apk documentation and tracking placeholders
!Apk/README.md
!Apk/.gitkeep

# =============================================================================
# IDE & Code Editors (Prevents leaking user workspace & device streaming IDs)
# =============================================================================
# VS Code
.vscode/
*.code-workspace

# JetBrains / Android Studio / PyCharm
.idea/
**/.idea/
*.iml
**/*.iml
*.ipr
*.iws
out/

# General text editors & swap files
*.swp
*.swo
*~
*.bak
*.sublime-project
*.sublime-workspace

# =============================================================================
# Operating System Artifacts
# =============================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.fuse_hidden*
.directory

# =============================================================================
# Secrets, Credentials & Local Configs
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.yaml
secrets.yml
config_local.py

# =============================================================================
# Testing, Coverage, Profiling & Tool Caches
# =============================================================================
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.prof
*.lprof
profile_output/

# =============================================================================
# Temporary Files & Logs
# =============================================================================
*.log
*.tmp
*.orig
tmp/
temp/
scratch/
